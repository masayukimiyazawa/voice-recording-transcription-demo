<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="login.title">Vonage Call Proxy - ログイン</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .login-container {
            background: white;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 400px;
        }
        
        .login-container h1 {
            text-align: center;
            color: #333;
            margin-bottom: 30px;
            font-size: 28px;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #555;
            font-weight: 500;
        }
        
        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 16px;
            transition: border-color 0.3s;
        }
        
        .form-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .btn {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        
        .btn:active {
            transform: translateY(0);
        }
        
        .error-message {
            color: #dc3545;
            background: #f8d7da;
            padding: 12px;
            border-radius: 4px;
            margin-bottom: 20px;
            display: none;
        }
        
        .info-message {
            color: #0c5460;
            background: #d1ecf1;
            padding: 12px;
            border-radius: 4px;
            margin-bottom: 20px;
        }
        
        .lang-switcher {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
        }
        
        .lang-switcher select {
            padding: 6px 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 13px;
            background: white;
            color: #333;
            cursor: pointer;
        }
        
        .lang-switcher select:focus {
            outline: none;
            border-color: #667eea;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="lang-switcher">
            <select id="langSelect" onchange="i18n.setLanguage(this.value)">
                <option value="ja">日本語</option>
                <option value="en">English</option>
            </select>
        </div>
        <h1>🎤 Vonage Call Proxy</h1>
        
        <form id="loginForm" method="POST" action="/login">
            <div class="error-message" id="errorMessage"></div>
            
            <div class="form-group">
                <label for="password" data-i18n="login.password_label">パスワード</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    data-i18n-placeholder="login.password_placeholder"
                    placeholder="パスワードを入力"
                    autocomplete="current-password"
                    required
                >
            </div>
            
            <!-- 言語選択をフォームに追加 -->
            <input type="hidden" id="language" name="language" value="en">
            
            <button type="submit" class="btn" data-i18n="login.submit">ログイン</button>
        </form>
    </div>
    
    <script src="/js/i18n.js"></script>
    <script>
        document.getElementById('langSelect').value = i18n.currentLang;
        // hiddenフィールドもページ読み込み時にドロップダウンと同期
        document.getElementById('language').value = i18n.currentLang;
        
        // 言語選択が変更されたとき、hiddenフィールドに値を設定
        document.getElementById('langSelect').addEventListener('change', function() {
            document.getElementById('language').value = this.value;
        });

        const urlParams = new URLSearchParams(window.location.search);
        const error = urlParams.get('error');
        if (error) {
            document.getElementById('errorMessage').textContent = i18n.t('login.error');
            document.getElementById('errorMessage').style.display = 'block';
        }
    </script>
</body>
</html>
