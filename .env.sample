# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Vonage Configuration
VONAGE_API_KEY=your_api_key
VONAGE_API_SECRET=your_api_secret
VONAGE_APPLICATION_ID=your_application_id
VONAGE_PRIVATE_KEY_PATH=./private.key
VONAGE_LVN=your_vonage_number

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vonage-proxy

# Portal Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
PORTAL_PASSWORD=your_secure_password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret

# --- Login brute-force protection ---
# All optional; the defaults below are used when unset.
# 5 failed logins from one client inside a 15 minute window trigger a
# lockout that starts at 60s and doubles (capped at 15 min).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_BASE_LOCKOUT_MS=60000
LOGIN_RATE_LIMIT_MAX_LOCKOUT_MS=900000
# Fleet-wide ceiling. Defeats distributed / X-Forwarded-For-spoofing
# attacks. Kept short so an attacker cannot lock out the real admin
# for long; set to 0 to disable.
LOGIN_RATE_LIMIT_GLOBAL_MAX_FAILURES=30
LOGIN_RATE_LIMIT_GLOBAL_LOCKOUT_MS=300000
